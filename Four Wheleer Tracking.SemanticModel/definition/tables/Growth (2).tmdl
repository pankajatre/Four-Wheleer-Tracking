table 'Growth (2)'
	lineageTag: 616c97fc-e2ea-4d28-9b8f-f83550eaa2ef

	measure 'Service Growth for table %' = ```
			
			    DIVIDE
			        (
			            [Total Service (Without Campaign Refurbish PDI)],
			            CALCULATE([Total Service (Without Campaign Refurbish PDI)],
			                    SAMEPERIODLASTYEAR(Dim_Date[Date]))
			        )-1
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4b0aeaf4-3b7e-4ea1-9144-23fa2b485d3e

	partition 'Growth (2)' = m
		mode: import
		queryGroup: 'Measure table'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

