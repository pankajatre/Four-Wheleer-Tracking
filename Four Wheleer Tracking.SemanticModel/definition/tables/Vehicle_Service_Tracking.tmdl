	column 'SERVICE STATUS Free and Paid for with second last sr type' = ```
			
			
			VAR Chassis =
			    'Vehicle_Service_Tracking'[Chassis_No]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR InsideOutside =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Is Inside]
			        )
			    )
			
			VAR IsInside =
			    InsideOutside = "INSIDE"
			
			VAR IsOutside =
			    InsideOutside = "OUTSIDE"
			
			VAR TotalService =
			    COALESCE(
			        'Vehicle_Service_Tracking'[Total Service],
			        0
			    )
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			
			/* =========================================================
			   SALE DAYS
			   ========================================================= */
			
			VAR SaleDays =
			    IF(
			        NOT ISBLANK(SaleDate),
			        DATEDIFF(
			            SaleDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			
			/* =========================================================
			   FIND LATEST VALID SERVICE
			
			   ACCIDENT + CAMPAIGN ko ignore karega.
			   ========================================================= */
			
			VAR ValidServiceTable =
			    FILTER(
			        ALL('Fact Service_Raw'),
			
			        'Fact Service_Raw'[Chassis_No] = Chassis
			
			            &&
			
			        NOT ISBLANK(
			            'Fact Service_Raw'[Closed_Date_Time]
			        )
			
			            &&
			
			        NOT(
			            UPPER(
			                TRIM(
			                    'Fact Service_Raw'[SR_Type]
			                )
			            )
			            IN {
			                "ACCIDENT",
			                "CAMPAIGN"
			            }
			        )
			    )
			
			
			/* =========================================================
			   LATEST VALID SERVICE DATE
			   ========================================================= */
			
			VAR EffectiveServiceDate =
			    MAXX(
			        TOPN(
			            1,
			            ValidServiceTable,
			            'Fact Service_Raw'[Closed_Date_Time],
			            DESC
			        ),
			        'Fact Service_Raw'[Closed_Date_Time]
			    )
			
			
			/* =========================================================
			   LATEST VALID SERVICE TYPE
			   ========================================================= */
			
			VAR EffectiveServiceType =
			    MAXX(
			        TOPN(
			            1,
			            ValidServiceTable,
			            'Fact Service_Raw'[Closed_Date_Time],
			            DESC
			        ),
			        UPPER(
			            TRIM(
			                'Fact Service_Raw'[SR_Type]
			            )
			        )
			    )
			
			
			/* =========================================================
			   DAYS FROM LAST VALID SERVICE
			
			   IMPORTANT:
			   ACTIVE / INACTIVE / PAID / FREE
			   sab isi date se calculate honge.
			   ========================================================= */
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(EffectiveServiceDate),
			        DATEDIFF(
			            EffectiveServiceDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			
			/* =========================================================
			   SERVICE TYPE
			   ========================================================= */
			
			VAR IsPDI =
			    EffectiveServiceType = "PDI"
			
			VAR IsFirstFree =
			    EffectiveServiceType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    EffectiveServiceType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    EffectiveServiceType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    EffectiveServiceType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			
			/* =========================================================
			   NEVER SERVICED
			   ========================================================= */
			
			VAR NeverServiced =
			    TotalService = 0
			
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			
			/* =========================================================
			   1. NEVER SERVICED - INSIDE
			   ========================================================= */
			
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 40
			        &&
			    SaleDays <= 55,
			
			    "CALL FOR FIRST SERVICE",
			
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 56
			        &&
			    SaleDays <= 71,
			
			    "FS MISSED 0",
			
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 72
			        &&
			    SaleDays <= 101,
			
			    "FS MISSED 1",
			
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 102
			        &&
			    SaleDays <= 159,
			
			    "FS MISSED",
			
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 40
			        &&
			    SaleDays <= 55,
			
			    "CALL FOR FIRST SERVICE",
			
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 56
			        &&
			    SaleDays <= 71,
			
			    "FS MISSED 0",
			
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 72
			        &&
			    SaleDays <= 101,
			
			    "FS MISSED 1",
			
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 102
			        &&
			    SaleDays <= 159,
			
			    "FS MISSED",
			
			
			/* =========================================================
			   3. FIRST FREE → SECOND FREE
			   INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    IsFirstFree
			        &&
			    SaleDays >= 160
			        &&
			    SaleDays <= 180,
			
			    "CALL FOR SECOND SERVICE",
			
			
			    IsInside
			        &&
			    IsFirstFree
			        &&
			    SaleDays >= 181
			        &&
			    SaleDays <= 195,
			
			    "SS MISSED 0",
			
			
			    IsInside
			        &&
			    IsFirstFree
			        &&
			    SaleDays >= 196
			        &&
			    SaleDays <= 224,
			
			    "SS MISSED 1",
			
			
			    IsInside
			        &&
			    IsFirstFree
			        &&
			    SaleDays >= 225
			        &&
			    SaleDays <= 344,
			
			    "SS MISSED",
			
			
			/* =========================================================
			   4. SECOND FREE → THIRD FREE
			   INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    IsSecondFree
			        &&
			    SaleDays >= 345
			        &&
			    SaleDays <= 365,
			
			    "CALL FOR THIRD SERVICE",
			
			
			    IsInside
			        &&
			    IsSecondFree
			        &&
			    SaleDays >= 366
			        &&
			    SaleDays <= 380,
			
			    "TS MISSED 0",
			
			
			    IsInside
			        &&
			    IsSecondFree
			        &&
			    SaleDays >= 381
			        &&
			    SaleDays <= 411,
			
			    "TS MISSED 1",
			
			
			    IsInside
			        &&
			    IsSecondFree
			        &&
			    SaleDays >= 412
			        &&
			    SaleDays <= 545,
			
			    "TS MISSED",
			
			
			/* =========================================================
			   5. OUTSIDE → FIRST FREE
			   ========================================================= */
			
			    IsOutside
			        &&
			    IsFirstFree
			        &&
			    ServiceDays >= 160
			        &&
			    ServiceDays <= 180,
			
			    "CALL FOR SECOND SERVICE",
			
			
			    IsOutside
			        &&
			    IsFirstFree
			        &&
			    ServiceDays >= 181
			        &&
			    ServiceDays <= 195,
			
			    "SS MISSED 0",
			
			
			    IsOutside
			        &&
			    IsFirstFree
			        &&
			    ServiceDays >= 196
			        &&
			    ServiceDays <= 224,
			
			    "SS MISSED 1",
			
			
			    IsOutside
			        &&
			    IsFirstFree
			        &&
			    ServiceDays >= 225
			        &&
			    ServiceDays <= 344,
			
			    "SS MISSED",
			
			
			/* =========================================================
			   6. OUTSIDE → SECOND FREE
			   ========================================================= */
			
			    IsOutside
			        &&
			    IsSecondFree
			        &&
			    ServiceDays >= 345
			        &&
			    ServiceDays <= 365,
			
			    "CALL FOR THIRD SERVICE",
			
			
			    IsOutside
			        &&
			    IsSecondFree
			        &&
			    ServiceDays >= 366
			        &&
			    ServiceDays <= 380,
			
			    "TS MISSED 0",
			
			
			    IsOutside
			        &&
			    IsSecondFree
			        &&
			    ServiceDays >= 381
			        &&
			    ServiceDays <= 411,
			
			    "TS MISSED 1",
			
			
			    IsOutside
			        &&
			    IsSecondFree
			        &&
			    ServiceDays >= 412
			        &&
			    ServiceDays <= 545,
			
			    "TS MISSED",
			
			
			/* =========================================================
			   7. THIRD FREE → PAID
			   INSIDE + OUTSIDE
			   ========================================================= */
			
			    IsThirdFree
			        &&
			    ServiceDays >= 156
			        &&
			    ServiceDays <= 175,
			
			    "CALL FOR PAID SERVICE",
			
			
			    IsThirdFree
			        &&
			    ServiceDays >= 176
			        &&
			    ServiceDays <= 190,
			
			    "PAID MISSED 0",
			
			
			    IsThirdFree
			        &&
			    ServiceDays >= 191
			        &&
			    ServiceDays <= 220,
			
			    "PAID MISSED 1",
			
			
			    IsThirdFree
			        &&
			    ServiceDays >= 221
			        &&
			    ServiceDays <= 350,
			
			    "PAID MISSED",
			
			
			/* =========================================================
			   8. PAID HISTORY → NEXT PAID
			   ========================================================= */
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 156
			        &&
			    ServiceDays <= 175,
			
			    "CALL FOR MINOR PAID",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 176
			        &&
			    ServiceDays <= 190,
			
			    "PAID MISSED MINOR 0",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 191
			        &&
			    ServiceDays <= 220,
			
			    "PAID MISSED MINOR 1",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 221
			        &&
			    ServiceDays <= 350,
			
			    "PAID MISSED MINOR",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 351
			        &&
			    ServiceDays <= 365,
			
			    "CALL FOR MAJOR PAID",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 366
			        &&
			    ServiceDays <= 380,
			
			    "PAID MISSED MAJOR 0",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 381
			        &&
			    ServiceDays <= 410,
			
			    "PAID MISSED MAJOR 1",
			
			
			    IsPaidHistory
			        &&
			    ServiceDays >= 411
			        &&
			    ServiceDays <= 545,
			
			    "PAID MISSED MAJOR",
			    /* =========================================================
			   1. NEVER SERVICED - INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 1
			        &&
			    SaleDays <= 39,
			
			    "NEW VEHICLE",
				
				
				/* =========================================================
			   2. PDI - INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 1
			        &&
			    SaleDays <= 39,
			
			    "NEW VEHICLE",
			    /* =========================================================
			   9. NEVER SERVICED - INACTIVE
			   ========================================================= */
			
			    NeverServiced
			        &&
			    SaleDays >= 546
			        &&
			    SaleDays <= 731,
			
			    "IN-ACTIVE",
			
			
			/* =========================================================
			   10. SERVICED VEHICLE - INACTIVE
			   ========================================================= */
			
			    NOT ISBLANK(EffectiveServiceDate)
			        &&
			    ServiceDays >= 546
			        &&
			    ServiceDays <= 731,
			
			    "IN-ACTIVE"
				
			)
			```
		lineageTag: 77d108c5-ae8b-45ea-aa5f-4637555dc0ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Active and New vehicle' = ```
			
			VAR Chassis =
			    'Vehicle_Service_Tracking'[Chassis_No]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR InsideOutside =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Is Inside]
			        )
			    )
			
			VAR IsInside =
			    InsideOutside = "INSIDE"
			
			VAR IsOutside =
			    InsideOutside = "OUTSIDE"
			
			VAR TotalService =
			    COALESCE(
			        'Vehicle_Service_Tracking'[Total Service],
			        0
			    )
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			
			/* =========================================================
			   SALE DAYS
			   ========================================================= */
			
			VAR SaleDays =
			    IF(
			        NOT ISBLANK(SaleDate),
			        DATEDIFF(
			            SaleDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			
			/* =========================================================
			   FIND LATEST VALID SERVICE
			
			   ACCIDENT + CAMPAIGN ko ignore karega.
			   ========================================================= */
			
			VAR ValidServiceTable =
			    FILTER(
			        ALL('Fact Service_Raw'),
			
			        'Fact Service_Raw'[Chassis_No] = Chassis
			
			            &&
			
			        NOT ISBLANK(
			            'Fact Service_Raw'[Closed_Date_Time]
			        )
			
			            &&
			
			        NOT(
			            UPPER(
			                TRIM(
			                    'Fact Service_Raw'[SR_Type]
			                )
			            )
			            IN {
			                "ACCIDENT",
			                "CAMPAIGN"
			            }
			        )
			    )
			
			
			/* =========================================================
			   LATEST VALID SERVICE DATE
			   ========================================================= */
			
			VAR EffectiveServiceDate =
			    MAXX(
			        TOPN(
			            1,
			            ValidServiceTable,
			            'Fact Service_Raw'[Closed_Date_Time],
			            DESC
			        ),
			        'Fact Service_Raw'[Closed_Date_Time]
			    )
			
			
			/* =========================================================
			   LATEST VALID SERVICE TYPE
			   ========================================================= */
			
			VAR EffectiveServiceType =
			    MAXX(
			        TOPN(
			            1,
			            ValidServiceTable,
			            'Fact Service_Raw'[Closed_Date_Time],
			            DESC
			        ),
			        UPPER(
			            TRIM(
			                'Fact Service_Raw'[SR_Type]
			            )
			        )
			    )
			
			
			/* =========================================================
			   DAYS FROM LAST VALID SERVICE
			
			   IMPORTANT:
			   ACTIVE / INACTIVE / PAID / FREE
			   sab isi date se calculate honge.
			   ========================================================= */
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(EffectiveServiceDate),
			        DATEDIFF(
			            EffectiveServiceDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			
			/* =========================================================
			   SERVICE TYPE
			   ========================================================= */
			
			VAR IsPDI =
			    EffectiveServiceType = "PDI"
			
			VAR IsFirstFree =
			    EffectiveServiceType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    EffectiveServiceType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    EffectiveServiceType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    EffectiveServiceType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			
			/* =========================================================
			   NEVER SERVICED
			   ========================================================= */
			
			VAR NeverServiced =
			    TotalService = 0
			
			
			RETURN
			
			SWITCH(
			    TRUE(),
			/* =========================================================
			   1. NEVER SERVICED - INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    NeverServiced
			        &&
			    SaleDays >= 1
			        &&
			    SaleDays <= 39,
			
			    "NEW VEHICLE",
				
				
				/* =========================================================
			   2. PDI - INSIDE
			   ========================================================= */
			
			    IsInside
			        &&
			    IsPDI
			        &&
			    SaleDays >= 1
			        &&
			    SaleDays <= 39,
			
			    "NEW VEHICLE",
				
				
				/* =========================================================
			   12. ACTIVE
			   ========================================================= */
			
			    NOT ISBLANK(EffectiveServiceDate)
			        &&
			    ServiceDays >= 0
			        &&
			    ServiceDays <= 155,
			
			    "ACTIVE")
			```
		lineageTag: 1e979a15-1610-4336-9e6a-3b9b1aef62f2
		summarizeBy: none

