	column 'FREE SERVICE(OUTSIDE)' = ```
			
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR OUTSIDER =
			    Vehicle_Service_Tracking[Is Inside] = "Outside"
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			VAR IsNewVehicle =
			    ISBLANK(LastServDate)
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			
			    /*============================FREE SERVICE FOR OUTSIDER==============================================================*/
			
			  /* =====================================================
			       2. SECOND FREE SERVICE
			       ===================================================== */
			
			    IsFirstFree 
			        && ServiceDays >= 160
			        && ServiceDays <= 180,
			        "CALL FOR SECOND SERVICE",
			
			    IsFirstFree 
			        && ServiceDays > 180
			        && ServiceDays <= 195,
			        "SS MISSED 0",
			
			    IsFirstFree 
			        && ServiceDays > 195
			        && ServiceDays <= 225,
			        "SS MISSED 1",
			
			    IsFirstFree 
			        && ServiceDays >= 225
			        && ServiceDays <= 344,
			        "SS MISSED",
			
			
			    /* =====================================================
			       3. THIRD FREE SERVICE 
			       ===================================================== */
			
			    IsSecondFree 
			        && ServiceDays >= 345
			        && ServiceDays <= 365,
			        "CALL FOR THIRD SERVICE",
			
			    IsSecondFree
			        && ServiceDays >= 366
			        && ServiceDays <= 380,
			        "TS MISSED 0",
			        
			    IsSecondFree
			        && ServiceDays >= 381
			        && ServiceDays <= 411,
			        "TS MISSED 1" ,
			    
			    IsSecondFree
			        && ServiceDays >= 412
			        && ServiceDays <= 545,
			        "TS MISSED"
			        
			        
			        
			        
			        
			        )
			```
