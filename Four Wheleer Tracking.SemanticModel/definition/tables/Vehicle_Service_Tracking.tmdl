	column 'Remove Outer chassis'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0b0fa02c-07d4-48a2-894a-002d93ea99b8
		summarizeBy: sum
		sourceColumn: Remove Outer chassis

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'SERVICE STATUS New from Sale Date' =
			
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR LastServiceDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR TotalServiceCount =
			    COALESCE(
			        'Vehicle_Service_Tracking'[Total Service],
			        0
			    )
			
			VAR SaleDays =
			    IF(
			        NOT ISBLANK(SaleDate),
			        DATEDIFF(
			            SaleDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServiceDate),
			        DATEDIFF(
			            LastServiceDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR IsNewVehicle =
			    ISBLANK(LastServiceDate)
			
			VAR IsPDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			    /* =====================================================
			       1. FIRST FREE SERVICE
			       ===================================================== */
			
			    IsFirstFree
			        && ServiceDays >= 0
			        && ServiceDays <= 60,
			        "ACTIVE",
			
			    IsNewVehicle
			        && SaleDays >= 1
			        && SaleDays <= 45,
			        "NEW VEHICLE",
			
			    IsNewVehicle
			        && SaleDays >= 46
			        && SaleDays <= 60,
			        "CALL FOR FIRST SERVICE",
			
			    IsNewVehicle
			        && SaleDays >= 61
			        && SaleDays <= 159,
			        "FS MISSED",
			
			
			    /* =====================================================
			       2. SECOND FREE SERVICE
			       ===================================================== */
			
			    IsSecondFree
			        && ServiceDays >= 0
			        && ServiceDays < 165,
			        "ACTIVE",
			
			    IsFirstFree
			        && SaleDays >= 165
			        && SaleDays <= 180,
			        "CALL FOR SECOND SERVICE",
			
			    IsFirstFree
			        && SaleDays >= 181
			        && SaleDays <= 195,
			        "SS MISSED 0",
			
			    IsFirstFree
			        && SaleDays >= 196
			        && SaleDays <= 225,
			        "SS MISSED 1",
			
			    IsFirstFree
			        && SaleDays >= 226
			        && SaleDays <= 344,
			        "SS MISSED",
			
			
			    /* =====================================================
			       3. THIRD FREE SERVICE
			       ===================================================== */
			
			    IsThirdFree
			        && ServiceDays >= 0
			        && ServiceDays < 345,
			        "ACTIVE",
			
			    IsSecondFree
			        && SaleDays >= 345
			        && SaleDays <= 365,
			        "CALL FOR THIRD SERVICE",
			
			    IsSecondFree
			        && SaleDays >= 366
			        && SaleDays <= 380,
			        "TS MISSED 0",
			
			    IsSecondFree
			        && SaleDays >= 381
			        && SaleDays <= 410,
			        "TS MISSED 1",
			
			    IsSecondFree
			        && SaleDays >= 411
			        && SaleDays <= 545,
			        "TS MISSED",
			
			
			    /* =====================================================
			       4. PAID SERVICE
			       ===================================================== */
			
			    IsPaidHistory
			        && SaleDays >= 0
			        && SaleDays < 155,
			        "ACTIVE",
			
			    IsThirdFree
			        && ServiceDays >= 155
			        && ServiceDays <= 175,
			        "CALL FOR PAID SERVICE",
			
			    IsThirdFree
			        && ServiceDays >= 176
			        && ServiceDays <= 190,
			        "PAID MISSED 0",
			
			    IsThirdFree
			        && ServiceDays >= 191
			        && ServiceDays <= 220,
			        "PAID MISSED 1",
			
			    IsThirdFree
			        && ServiceDays >= 221
			        && ServiceDays <= 365,
			        "PAID MISSED",
			
			
			    /* =====================================================
			       5. PAID SERVICE / OTHER SERVICE HISTORY
			       ===================================================== */
			
			    IsPaidHistory
			        && ServiceDays >= 0
			        && ServiceDays <= 154,
			        "ACTIVE",
			
			    IsPaidHistory
			        && ServiceDays >= 155
			        && ServiceDays <= 175,
			        "CALL FOR MINOR PAID",
			
			    IsPaidHistory
			        && ServiceDays >= 176
			        && ServiceDays <= 190,
			        "PAID MISSED MINOR 0",
			
			    IsPaidHistory
			        && ServiceDays >= 191
			        && ServiceDays <= 220,
			        "PAID MISSED MINOR 1",
			
			    IsPaidHistory
			        && ServiceDays >= 221
			        && ServiceDays <= 350,
			        "PAID MISSED MINOR",
			
			    IsPaidHistory
			        && ServiceDays >= 351
			        && ServiceDays <= 365,
			        "CALL FOR MAJOR PAID",
			
			    IsPaidHistory
			        && ServiceDays >= 366
			        && ServiceDays <= 380,
			        "PAID MISSED MAJOR 0",
			
			    IsPaidHistory
			        && ServiceDays >= 381
			        && ServiceDays <= 410,
			        "PAID MISSED MAJOR 1",
			
			    IsPaidHistory
			        && ServiceDays >= 411
			        && ServiceDays <= 545,
			        "PAID MISSED MAJOR",
			
			
			    /* =====================================================
			       6. NEVER SERVICED
			       Sold vehicle but never took service
			       ===================================================== */
			
			    TotalServiceCount = 0
			        && SaleDays > 380
			        && SaleDays <= 545,
			        "NEVER SERVICED",
			
			
			    /* =====================================================
			       7. PREVIOUSLY SERVICED - INACTIVE
			       ===================================================== */
			
			    TotalServiceCount > 0
			        && ServiceDays > 365
			        && ServiceDays <= 545
			        && TotalServiceCount <= 3,
			        "INACTIVE FROM 1 YEAR WITH <= 3",
			
			    TotalServiceCount > 3
			        && ServiceDays > 365
			        && ServiceDays <= 545,
			        "INACTIVE FROM 1 YEAR WITH >3",
			
			
			    /* =====================================================
			       8. INACTIVE - 546 TO 730 DAYS
			       ===================================================== */
			
			    TotalServiceCount > 0
			        && ServiceDays >= 546
			        && ServiceDays <= 730,
			        "IN-ACTIVE",
			
			
			    /* =====================================================
			       9. DEAD
			       ===================================================== */
			
			    TotalServiceCount = 0
			        && SaleDays > 545,
			        "DEAD",
			
			    TotalServiceCount > 0
			        && ServiceDays > 730,
			        "DEAD"
			
			
			
			
			
			    /* =====================================================
			       DEFAULT
			       ===================================================== */
			)
		lineageTag: 83c42516-d96e-4e09-ab87-d38602cae5f2
