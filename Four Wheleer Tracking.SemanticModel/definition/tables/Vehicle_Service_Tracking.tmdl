	column 'FREE SERVICE(INSIDE)' = ```
			
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR OUTSIDER =
			    Vehicle_Service_Tracking[Is Inside] = "OUTSIDE"
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			VAR IsNewVehicle =
			    ISBLANK(LastServDate)
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			/*============================FREE SERVICE FOR INSIDE==============================================================*/
			
			  IsNewVehicle && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 40
			        && SaleDays <= 55,
			        "CALL FOR FIRST SERVICE",
			
			
			    PDI && SaleDays >= 40
			        && SaleDays <= 55,
			        "CALL FOR FIRST SERVICE",
			
			     PDI && ServiceDays >= 40
			        && ServiceDays <= 55,
			        "CALL FOR FIRST SERVICE",
			
			   
			------------------
			
			     PDI && SaleDays > 55
			        && SaleDays <= 71,
			        "FS MISSED 0",
			
			     PDI
			        && SaleDays > 55
			        && SaleDays <= 71
			        && ServiceDays > 55
			        && ServiceDays <= 71,
			        "FS MISSED 0",
			
			    IsNewVehicle && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays > 55
			        && SaleDays <= 71,
			        "FS MISSED 0",
			
			------------------
			
			     PDI && SaleDays > 71
			        && SaleDays <= 101,
			        "FS MISSED 1",
			
			     PDI
			        && SaleDays > 71
			        && SaleDays <= 101
			        && ServiceDays > 71
			        && ServiceDays <= 101,
			        "FS MISSED 1",
			
			    IsNewVehicle && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays > 71
			        && SaleDays <= 101,
			        "FS MISSED 1",
			
			    ----------------------
			    PDI && SaleDays > 101
			        && SaleDays <= 159,
			        "FS MISSED",
			
			     PDI
			        && SaleDays > 101
			        && SaleDays <= 159
			        && ServiceDays > 56
			        && ServiceDays <= 159,
			        "FS MISSED",
			
			    IsNewVehicle && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays > 101
			        && SaleDays <= 159,
			        "FS MISSED",
			
			
			    /* =====================================================
			       2. SECOND FREE SERVICE
			       ===================================================== */
			
			    IsFirstFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 160
			        && SaleDays <= 180,
			        "CALL FOR SECOND SERVICE",
			
			    IsFirstFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays > 180
			        && SaleDays <= 195,
			        "SS MISSED 0",
			
			    IsFirstFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays > 195
			        && SaleDays <= 225,
			        "SS MISSED 1",
			
			    IsFirstFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 225
			        && SaleDays <= 344,
			        "SS MISSED",
			
			
			    /* =====================================================
			       3. THIRD FREE SERVICE 
			       ===================================================== */
			
			    IsSecondFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 345
			        && SaleDays <= 365,
			        "CALL FOR THIRD SERVICE",
			
			    IsSecondFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 366
			        && SaleDays <= 380,
			        "TS MISSED 0",
			        
			    IsSecondFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 381
			        && SaleDays <= 411,
			        "TS MISSED 1" ,
			    
			    IsSecondFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >= 412
			        && SaleDays <= 545,
			        "TS MISSED"
			        
			        )
			```
