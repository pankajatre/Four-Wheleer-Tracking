		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Is Inside' = IF(ISBLANK(Vehicle_Service_Tracking[Invoice_Date]),"Outside","Inside")
		lineageTag: 1e1a5c8d-f9c9-492f-b2f9-27f69bd5a98f
