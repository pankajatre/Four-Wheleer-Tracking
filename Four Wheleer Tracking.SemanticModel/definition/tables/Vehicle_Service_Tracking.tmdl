	column 'NEVER SERVICED' = ```
			
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR OUTSIDER =
			    Vehicle_Service_Tracking[Is Inside] = "OUTSIDE"
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			
			    
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR IsNewVehicle =
			    SaleDays <= 60
			
			VAR TotalServiceCount =
			    Vehicle_Service_Tracking[Total Service]>0
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			
			SWITCH(
			    TRUE(),
			
			        Vehicle_Service_Tracking[Total Service] = 0
			        && SaleDays > 380
			        && SaleDays <= 545,
			        "NEVER SERVICED"
			)
