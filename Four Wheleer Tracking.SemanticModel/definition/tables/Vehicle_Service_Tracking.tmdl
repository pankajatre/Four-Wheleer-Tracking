	column 'Age Bucket' =
			SWITCH(TRUE(),
			Vehicle_Service_Tracking[Vechele Age Month] <= 12,"0-1 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 12 && Vehicle_Service_Tracking[Vechele Age Month] <= 24,"1-2 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 24 && Vehicle_Service_Tracking[Vechele Age Month] <= 36,"2-3 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 36 && Vehicle_Service_Tracking[Vechele Age Month] <= 48,"3-4 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 48 && Vehicle_Service_Tracking[Vechele Age Month] <= 60,"4-5 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 60 && Vehicle_Service_Tracking[Vechele Age Month] <= 72,"5-6 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 72 && Vehicle_Service_Tracking[Vechele Age Month] <= 84,"6-7 year",
			Vehicle_Service_Tracking[Vechele Age Month] > 84, "8+ year"
			
			)
		lineageTag: ba83d99c-6500-49d8-aff7-6752243cb81d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'First System Login Date' = IF(ISBLANK(Vehicle_Service_Tracking[Invoice_Date]),Vehicle_Service_Tracking[First SR Date],Vehicle_Service_Tracking[Invoice_Date])
