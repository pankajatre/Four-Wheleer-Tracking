	column ACTIVE = ```
			
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			VAR IsNewVehicle =
			    ISBLANK(LastServDate)
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "THIRD FREE SERVICE",
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			
			
			 /* =====================================================
			       6. OLD ACTIVE VEHICLES
			       ===================================================== */
			
			   NOT PDI && ServiceDays <= 155 && NOT ISBLANK(LastServDate), "ACTIVE",
			
			    IsSecondFree 
			        && ServiceDays >= 156
			        && ServiceDays <= 345,
			        "ACTIVE",
			
			    IsThirdFree
			        && ServiceDays >= 156
			        && ServiceDays <= 345,
			        "ACTIVE"
			   
			   
			
			
			      
			)
			```
		isHidden
		lineageTag: 705020a0-90c7-492c-9422-e2acc3ca188d
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column DEAD = ```
			
			
			VAR LastServDate =
			    'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR SaleDate =
			    'Vehicle_Service_Tracking'[Invoice_Date]
			
			VAR LastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			VAR IsNewVehicle =
			    ISBLANK(LastServDate)
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        "THIRD FREE SERVICE",
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			   PDI && ISBLANK(Vehicle_Service_Tracking[ACTIVE]) 
			   && SaleDays >344 && SaleDays <545,
			        "In-Active",
			
			    PDI && ISBLANK(Vehicle_Service_Tracking[ACTIVE]) 
			    && ServiceDays >=160 && ServiceDays <545,
			        "In-Active",
			
			
			IsFirstFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >344 && SaleDays <545,
			        "In-Active",
			
			IsFirstFree 
			        && ServiceDays >344  && ServiceDays <= 545,
			        "In-Active",
			
			
			IsSecondFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >344 && SaleDays <545,
			        "In-Active",
			
			IsThirdFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && SaleDays >344 && SaleDays <545,
			        "In-Active",
			
			IsThirdFree && ISBLANK(Vehicle_Service_Tracking[ACTIVE])
			        && ServiceDays >344 && ServiceDays <545,
			        "In-Active",
			
			
			  IsPaidHistory
			        && ServiceDays > 545
			        && ServiceDays <= 731,
			        "In-Active",
			ISBLANK(Vehicle_Service_Tracking[NEVER SERVICED]) &&
			    SaleDays > 160 && ServiceDays = 0,
			        "In-Active",
			
			  /* =====================================================
			       7. DEAD
			       ===================================================== */
			
			    LastActive > 731
			        || ServiceDays >= 546,
			        "DEAD")
			
			
			```
