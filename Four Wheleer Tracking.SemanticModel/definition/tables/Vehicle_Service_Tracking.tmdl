			VAR SecondLastSRType =
			    UPPER(
			        TRIM(
			            'Vehicle_Service_Tracking'[Second Last SR_Type]
			        )
			    )
			
			VAR LastActive =
			    'Vehicle_Service_Tracking'[LAST ACTIVE]
			
			VAR IsNewVehicle =
			    ISBLANK(LastServDate)
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServDate),
			        DATEDIFF(
			            LastServDate,
			            TODAY(),
			            DAY
			        )
			    )
			
			VAR PDI =
			    LastSRType = "PDI"
			
			VAR IsFirstFree =
			    LastSRType = "FIRST FREE SERVICE"
			
			VAR IsSecondFree =
			    LastSRType = "SECOND FREE SERVICE"
			
			VAR IsThirdFree =
			    LastSRType = "THIRD FREE SERVICE"
			
			VAR IsPaidHistory =
			    LastSRType IN {
			        
			        "PAID SERVICE",
			        "RUNNING REPAIRS",
			        "CAMPAIGN",
			        "ACCIDENT",
			        "E BREAKDOWN",
			        "CHASSIS NOT EXISTING",
			        "FOURTH FREE SERVICE",
			        "REFURBISH"
			    }
			
			RETURN
			
			SWITCH(
			    TRUE(),
			
			    /* =====================================================
			       1. NEVER SERVICED / NEW VEHICLE
			       ===================================================== */
			
			    IsNewVehicle
			        && SaleDays >= 1
			        && SaleDays <= 39,
			        "NEW VEHICLE",
			    
			    PDI && SaleDays >= 1
			        && SaleDays <= 39,
			        "NEW VEHICLE"
			    
			        
			        
			        )
