		annotation SummarizationSetBy = Automatic

	column 'SERVICE STATUS OLD' = ```
			
			VAR LASTSERVDATE = 'Vehicle_Service_Tracking'[Last SR Date]
			
			VAR BASEDATE = IF(ISBLANK(Vehicle_Service_Tracking[Last SR Date]),'Vehicle_Service_Tracking'[Invoice_Date],Vehicle_Service_Tracking[Last SR Date])
			VAR DAYSGAP = DATEDIFF(BASEDATE,TODAY(),DAY)
			VAR ISNEWVEHICLE = ISBLANK(Vehicle_Service_Tracking[Last SR Date])
			
			VAR SALEDATE = 'Vehicle_Service_Tracking'[Invoice_Date]
			VAR SALDAYSGAP = DATEDIFF(SALEDATE,TODAY(),DAY)
			VAR SERVICE_AGGING =IF(DATEDIFF('Vehicle_Service_Tracking'[Invoice_Date],Vehicle_Service_Tracking[Last SR Date],DAY)>0,DATEDIFF('Vehicle_Service_Tracking'[Invoice_Date],Vehicle_Service_Tracking[Last SR Date],DAY),0)
			
			
			VAR PDI = Vehicle_Service_Tracking[Last SR_Type]="PDI"
			
			
			RETURN
			SWITCH(TRUE(),
			--------------------------------FIRST---------------------------------------------
			ISNEWVEHICLE && DAYSGAP >=1 && DAYSGAP <=45, "NEW VEHICLE",
			
			NOT ISNEWVEHICLE && DAYSGAP >=1 && DAYSGAP <=45, "ACTIVE",
			NOT ISNEWVEHICLE && DAYSGAP >=46 && DAYSGAP <=60, "ACTIVE",
			NOT ISNEWVEHICLE && DAYSGAP >=61 && DAYSGAP <=159 && Vehicle_Service_Tracking[Last SR_Type] = "FIRST FREE SERVICE", "ACTIVE",
			
			ISNEWVEHICLE && DAYSGAP >=40 && DAYSGAP <= 55,"CALL FOR FIRST SERVICE", 
			ISNEWVEHICLE && DAYSGAP >=56 && DAYSGAP <=159 ,"FS MISSED",
			
			---------------------SECOND --------------------------
			ISNEWVEHICLE && DAYSGAP >=160 && DAYSGAP <= 175 ||
			NOT ISNEWVEHICLE && SALDAYSGAP >=160 && SALDAYSGAP <=175
			&& Vehicle_Service_Tracking[Last SR_Type] = "FIRST FREE SERVICE","CALL FOR SECOND SERVICE",
			
			Vehicle_Service_Tracking[LAST ACTIVE] >=160 && Vehicle_Service_Tracking[LAST ACTIVE] <=175 
			&& Vehicle_Service_Tracking[Last SR_Type] = "FIRST FREE SERVICE", "CALL FOR SECOND SERVICE",
			
			ISNEWVEHICLE && DAYSGAP >=181 && DAYSGAP <= 344 ||
			NOT ISNEWVEHICLE && SALDAYSGAP >=181 && SALDAYSGAP <= 344 && Vehicle_Service_Tracking[Last SR_Type] = "FIRST FREE SERVICE" , "SS MISSED",
			
			
			NOT ISNEWVEHICLE && DAYSGAP <=180 &&
			Vehicle_Service_Tracking[Last SR_Type] = "SECOND FREE SERVICE", "ACTIVE",
			
			--NOT ISNEWVEHICLE && DAYSGAP >=161 && DAYSGAP <=180 &&
			--Vehicle_Service_Tracking[Last Service Type] = "SECOND FREE SERVICE", "ACTIVE",
			
			
			
			---------------------THIRD --------------------------
			
			ISNEWVEHICLE && DAYSGAP >=345 && DAYSGAP <= 360 ||
			NOT ISNEWVEHICLE && SALDAYSGAP >=345 && SALDAYSGAP <=360 
			&& Vehicle_Service_Tracking[Last SR_Type] = "SECOND FREE SERVICE" || 
			Vehicle_Service_Tracking[LAST ACTIVE] >=345 && Vehicle_Service_Tracking[LAST ACTIVE] <=365 
			&& Vehicle_Service_Tracking[Last SR_Type] = "SECOND FREE SERVICE", "CALL FOR THIRD SERVICE",
			
			ISNEWVEHICLE && DAYSGAP >=365 && DAYSGAP <= 544 ||
			NOT ISNEWVEHICLE && SALDAYSGAP >=365 && SALDAYSGAP <= 544 && Vehicle_Service_Tracking[Last SR_Type] = "SECOND FREE SERVICE" , "TS MISSED",
			
			NOT ISNEWVEHICLE && DAYSGAP <=345 &&
			Vehicle_Service_Tracking[Last SR_Type] = "THIRD FREE SERVICE", "ACTIVE",
			
			NOT ISNEWVEHICLE && DAYSGAP >=345 && DAYSGAP <=365 &&
			Vehicle_Service_Tracking[Last SR_Type] = "THIRD FREE SERVICE", "ACTIVE",
			
			
			------------------------------------------PAID---------------------------
			
			NOT ISNEWVEHICLE && DAYSGAP <= 154 &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free Service" ,"Refurbish" }, "ACTIVE",
			
			NOT ISNEWVEHICLE && DAYSGAP >=155 && DAYSGAP <=175 &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free Service" ,"Refurbish" }, "CALL FOR PAID SERVICE",
			
			NOT ISNEWVEHICLE && DAYSGAP >= 176  && DAYSGAP <=200 &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free --Service" ,"Refurbish" }, "CALL FOR MINOR PAID",
			
			--IF ISSUE THEN DELETE THIS LOGIC
			NOT ISNEWVEHICLE && DAYSGAP >= 201  && DAYSGAP <=363 &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free --Service" ,"Refurbish" }, "PAID MISSED MINOR",
			
			NOT ISNEWVEHICLE && DAYSGAP >= 364 && DAYSGAP <= 400  &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free Service" ,"Refurbish" },"CALL FOR MAJOR PAID",
			
			NOT ISNEWVEHICLE && DAYSGAP >= 401 && DAYSGAP <= 546  &&
			Vehicle_Service_Tracking[Last SR_Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free Service" ,"Refurbish" },"PAID MISSED MAJOR",
			--IF ISSUE THEN DELETE THIS LOGIC
			
			
			--NOT ISNEWVEHICLE && DAYSGAP >= 156 && DAYSGAP <= 180 &&
			--Vehicle_Service_Tracking[Last Service Type] IN{"THIRD FREE SERVICE","PAID SERVICE","Running Repairs","Campaign","Accident" ,"E Breakdown","Chassis Not Existing" ,"Fourth Free Service" ,"Refurbish" }, "ACTIVE",
			
			
			
			-----------------------------------IN ACTIVE----------------
			--IF ISSUE THEN DELETE THIS LOGIC
			Vehicle_Service_Tracking[LAST ACTIVE] >= 366 && Vehicle_Service_Tracking[LAST ACTIVE] <= 544 && Vehicle_Service_Tracking[Last SR_Type] IN{"FIRST FREE SERVICE","SECOND FREE SERVICE"},"IN-ACTIVE",
			--IF ISSUE THEN DELETE THIS LOGIC
			
			 PDI && Vehicle_Service_Tracking[LAST ACTIVE] >= 366 ,"IN-ACTIVE",
			
			Vehicle_Service_Tracking[LAST ACTIVE] >= 547 && Vehicle_Service_Tracking[LAST ACTIVE] <= 730,"IN-ACTIVE",
			NOT ISBLANK(Vehicle_Service_Tracking[LAST ACTIVE]) && Vehicle_Service_Tracking[LAST ACTIVE] <= 364,"ACTIVE", 
			Vehicle_Service_Tracking[LAST ACTIVE] >= 731 || DAYSGAP >=546,"DEAD"
			
			
			
			)
			
			```
