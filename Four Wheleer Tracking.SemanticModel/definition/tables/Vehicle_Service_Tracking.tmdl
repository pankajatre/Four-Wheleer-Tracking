	column 'STATUS FLAG' = ```
			
			SWITCH(TRUE(), 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED 0"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED 1"|| 
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "FS MISSED"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "FS MISSED 0"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "FS MISSED 1"||
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "SS MISSED"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "SS MISSED 0"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "SS MISSED 1"||
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "TS MISSED"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "TS MISSED 0"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "TS MISSED 1"||
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MINOR"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MINOR 0"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MINOR 1"||
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MAJOR"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MAJOR 0"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "PAID MISSED MAJOR 1", 
			
			"MISSED",
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR FIRST SERVICE"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR SECOND SERVICE"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR THIRD SERVICE"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR PAID SERVICE"||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR MAJOR PAID" ||
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "CALL FOR MINOR PAID",
			"NEED TO CALL",
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "ACTIVE"|| 
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "NEW VEHICLE",
			"ACTIVE",
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "DEAD",
			"DEAD",
			
			Vehicle_Service_Tracking[Service Status All Coalesce New]= "IN-ACTIVE",
			"IN-ACTIVE", "NEVER SERVICED"
			)
			
			```
		lineageTag: 028f4291-8db8-448d-a1c0-a2f6bf48879d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

